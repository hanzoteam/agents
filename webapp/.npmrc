save-exact=true

# The @hanzoteam packages are published on the fabric's own registry, reached at
# the one public endpoint. api.hanzo.ai rather than git.hanzo.ai because that is
# the host the registry itself advertises in every tarball URL it serves, so one
# credential prefix covers both the metadata read and the tarball fetch — split
# them and npm authenticates the first and 401s the second.
@hanzoteam:registry=https://api.hanzo.ai/v1/packages/hanzoteam/npm/
